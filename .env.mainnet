# ============================================================================
# Warriors AI Arena - Avalanche C-Chain MAINNET Forge Deployment Config
# ============================================================================
# This file configures the Foundry deployment to Avalanche C-Chain Mainnet.
# It mirrors the testnet .env but with mainnet-specific values.
#
# SETUP:
#   1. Generate a fresh deployer wallet:
#        cast wallet new
#   2. Fund it with real AVAX (~3 AVAX recommended for deploying 16 contracts):
#        - Buy AVAX on an exchange and withdraw to C-Chain
#        - Or bridge from another chain via https://core.app/bridge/
#   3. Get a free Snowtrace API key:
#        https://snowtrace.io/register → My API Keys → Create
#   4. Fill in values below, then:
#        cp .env.mainnet .env
#   5. Deploy:
#        ./scripts/deploy-mainnet.sh
#      Or manually:
#        forge script script/DeployAvalancheSimplified.s.sol \
#          --rpc-url https://api.avax.network/ext/bc/C/rpc \
#          --broadcast --verify \
#          --etherscan-api-key <YOUR_KEY> -vvvv
# ============================================================================

# ---------- Deployer Wallet ----------
# Fresh private key with 0x prefix. NEVER reuse testnet keys on mainnet.
DEPLOYER_PRIVATE_KEY=0x_REPLACE_WITH_YOUR_MAINNET_PRIVATE_KEY

# ---------- AI Signer ----------
# The address whose signatures are verified on-chain for warrior traits and
# battle moves. This can be the same keypair as testnet if the AI backend
# signs with the same key, but consider rotating for mainnet.
AI_SIGNER_ADDRESS=0xFc46DA4cbAbDca9f903863De571E03A39D9079aD

# ---------- Snowtrace Verification ----------
# Required for Retro9000: all contracts must be verified on Snowtrace.
# Free key from https://snowtrace.io/myapikey
SNOWTRACE_API_KEY=_REPLACE_WITH_YOUR_SNOWTRACE_API_KEY

# ---------- Oracle ----------
# Optional dedicated oracle address for PredictionMarketAMM.
# If unset, the deployer address is used as oracle.
# ORACLE_ADDRESS=0x...

# ============================================================================
# POST-DEPLOYMENT: These are auto-populated by DeployAvalancheSimplified.s.sol
# into deployments/avalanche-mainnet.json. You can also set them here for
# scripts that source .env directly (e.g., verify-contracts-snowtrace.sh).
# ============================================================================
CROWN_TOKEN=
OUTCOME_TOKEN=
WARRIORS_NFT=
