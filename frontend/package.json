    "@types/crypto-js": "^4.2.2",
    "@types/react-image-crop": "^8.1.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.0.1",
    "ethers": "^6.13.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.522.0",
    "next": "^15.3.6",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
