    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "fake-indexeddb": "^6.0.1",
    "happy-dom": "^15.11.7",
    "msw": "^2.14.3",
